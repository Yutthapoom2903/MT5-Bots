# ตัวอย่างเท่านั้น — ไฟล์นี้ติดตาม git อยู่ ห้ามกรอกค่าจริงลงไป
#
# คัดลอกเป็น .env แล้วกรอกในไฟล์นั้นแทน (.env อยู่ใน .gitignore)
#     Windows : copy .env.example .env
#     Linux   : cp .env.example .env
#
# python-dotenv อ่านเฉพาะ .env ไฟล์นี้ไม่มีผลกับการทำงาน

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
