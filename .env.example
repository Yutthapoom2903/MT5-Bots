# ตัวอย่างเท่านั้น — ไฟล์นี้ติดตาม git อยู่ ห้ามกรอกค่าจริงลงไป
#
# คัดลอกเป็น .env แล้วกรอกในไฟล์นั้นแทน (.env อยู่ใน .gitignore)
#     Windows : copy .env.example .env
#     Linux   : cp .env.example .env
#
# python-dotenv อ่านเฉพาะ .env ไฟล์นี้ไม่มีผลกับการทำงาน

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# path ของ terminal64.exe — เว้นว่างไว้ได้ถ้าสั่งบอทจากหน้าจอเครื่องเดียวกับ MT5
# ต้องกรอกเมื่อสั่งผ่าน SSH หรือ scheduled task เพราะ session แบบนั้นหา terminal
# เองไม่เจอ แล้วล้มด้วย -10003 ทั้งที่ terminal เปิดค้างอยู่
# ตัวอย่าง: C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TERMINAL_PATH=
